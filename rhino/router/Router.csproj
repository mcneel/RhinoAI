<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rhino-mcp-router</AssemblyName>
    <RootNamespace>Rhino.AI.Router</RootNamespace>
    <Title>Rhino MCP Router</Title>
    <Description>Stdio MCP router that proxies tool calls to one or more Rhino MCP plugin instances. Spawns and manages child Rhinos so Claude Code only ever talks to one stable endpoint.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64</RuntimeIdentifiers>
    <RhinoTarget Condition="'$(RhinoTarget)' == ''">R9</RhinoTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' AND $(RuntimeIdentifier.StartsWith('win-'))">
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' AND !$(RuntimeIdentifier.StartsWith('win-'))">
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <NativeDebugSymbols>false</NativeDebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Router.Tests" />
    <Compile Remove="codegen/**" />
    <None Remove="codegen/**" />
    <EmbeddedResource Remove="codegen/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>

  <!-- winsqlite3 ships with Windows; the e_sqlite3.dll bundle is unversioned and the Rhino installer cannot service it. -->
  <PropertyGroup>
    <RouterUsesWinSqlite Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('win-'))</RouterUsesWinSqlite>
    <RouterUsesWinSqlite Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</RouterUsesWinSqlite>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.6" Condition="'$(RouterUsesWinSqlite)' == 'true'" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" Condition="'$(RouterUsesWinSqlite)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="codegen/Router.Codegen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="../plugin/Tools/**/*.cs" />
    <AdditionalFiles Remove="../plugin/Tools/GH2/**/*.cs" Condition="'$(RhinoTarget)' == 'R8'" />
  </ItemGroup>

  <!-- dlopen looks next to the AOT binary in native/, not in $(OutDir). -->
  <Target Name="CopyNativeSqliteAlongsideAotBinary" AfterTargets="Build" Condition="'$(PublishAot)' == 'true' AND Exists('$(OutDir)libe_sqlite3.dylib')">
    <Copy SourceFiles="$(OutDir)libe_sqlite3.dylib" DestinationFolder="$(OutDir)native" SkipUnchangedFiles="true" />
  </Target>

</Project>
