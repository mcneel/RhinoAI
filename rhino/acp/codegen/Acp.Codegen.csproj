<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Acp.Codegen</AssemblyName>
    <RootNamespace>Acp.Codegen</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Windows Application Control blocks the unsigned apphost, so run through dotnet instead. -->
    <UseAppHost>false</UseAppHost>
    <RollForward>Major</RollForward>
  </PropertyGroup>

</Project>
