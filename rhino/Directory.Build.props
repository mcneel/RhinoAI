<Project>

  <PropertyGroup>
    <RhinoSrc4Dir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', '..'))</RhinoSrc4Dir>
    <IsInRhino Condition="'$(IsInRhino)' == '' AND Exists('$(RhinoSrc4Dir)version.cs.props')">true</IsInRhino>
    <IsInRhino Condition="'$(IsInRhino)' == ''">false</IsInRhino>
  </PropertyGroup>

  <!-- MSBuild stops at the first Directory.Build.props it finds, so the tree-wide one has to be chained by hand. -->
  <Import Project="$(RhinoSrc4Dir)Directory.Build.props" Condition="'$(IsInRhino)' == 'true'" />
  <Import Project="$(RhinoSrc4Dir)version.cs.props" Condition="'$(IsInRhino)' == 'true'" />

  <PropertyGroup>
    <RhinoAIPackageVersion>9.9.9</RhinoAIPackageVersion>
    <Version Condition="'$(IsInRhino)' == 'false'">$(RhinoAIPackageVersion)</Version>
    <Company Condition="'$(IsInRhino)' == 'false'">Robert McNeel &amp; Associates</Company>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
