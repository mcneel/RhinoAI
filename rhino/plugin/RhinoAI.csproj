<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(RhinoSrc4Dir)RhinoProjectPropertySheets/Rhino.CS.PlugIn.props" Condition="'$(IsInRhino)' == 'true'" />

  <PropertyGroup>
    <RhinoTarget Condition="'$(RhinoTarget)' == ''">R9</RhinoTarget>
    <PluginOS Condition="'$(PluginOS)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">win</PluginOS>
    <PluginOS Condition="'$(PluginOS)' == ''">osx</PluginOS>
    <RouterRids Condition="'$(RouterRids)' == '' AND '$(PluginOS)' == 'win'">win-x64;win-arm64</RouterRids>
    <RouterRids Condition="'$(RouterRids)' == ''">osx-arm64</RouterRids>
    <AspNetCoreRuntimeVersion>8.0.30</AspNetCoreRuntimeVersion>
    <AspNetCoreRuntimeRid Condition="'$(PluginOS)' == 'win'">win-x64</AspNetCoreRuntimeRid>
    <AspNetCoreRuntimeRid Condition="'$(PluginOS)' == 'osx'">osx-arm64</AspNetCoreRuntimeRid>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>RhinoAI</AssemblyName>
    <RootNamespace>Rhino.AI</RootNamespace>
    <Title>Rhino AI</Title>
    <Description>AI tools for Rhino</Description>
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);$(RhinoTarget)</DefineConstants>
    <!-- CS0436: version.cs is also compiled into referenced Rhino assemblies whose internals are visible here. -->
    <NoWarn>$(NoWarn);NU1701;CA1416;MSB3277;CS0436</NoWarn>
    <PluginOutputDir>$(MSBuildProjectDirectory)/bin/$(RhinoTarget)-$(PluginOS)/$(Configuration)</PluginOutputDir>
    <OutputPath>$(PluginOutputDir)/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.App.Runtime.$(AspNetCoreRuntimeRid)" Version="$(AspNetCoreRuntimeVersion)" ExcludeAssets="all" PrivateAssets="all" />
    <ProjectReference Include="../acp/Acp.csproj" />
    <Compile Include="../router/RouterPaths.ai.cs" Link="RouterPaths.ai.cs" />
  </ItemGroup>

  <!-- 8.19 is the first Rhino 8 package with .NET Core assets. -->
  <ItemGroup Condition="'$(RhinoTarget)' == 'R8'">
    <PackageReference Include="RhinoCommon" Version="8.19.25132.1001" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="8.19.25132.1001" ExcludeAssets="runtime" />
    <Compile Remove="Tools/GH2/**/*.cs;Resources/GH2/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RhinoTarget)' == 'R9'">
    <PackageReference Include="RhinoCommon" Version="9.0.26132.12305-wip" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="9.0.26132.12305-wip" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper2" Version="9.0.26132.12305-wip" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoCode" Version="9.0.26244.12303-beta" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../art/*.svg;../../art/*.ico" />
    <EmbeddedResource Include="Agents/Definitions.json" />
    <EmbeddedResource Include="Agents/codex-config.toml" LogicalName="Rhino.AI.codex-config.toml" />
    <EmbeddedResource Include="../panel/dist/panel.host.html" LogicalName="Rhino.AI.panel.html" />
  </ItemGroup>

  <Target Name="BuildPanel" BeforeTargets="BeforeBuild" Condition="'$(SkipPanelBuild)' != 'true' AND Exists('$(MSBuildProjectDirectory)/../panel/node_modules/esbuild')">
    <Exec Command="node build.mjs" WorkingDirectory="$(MSBuildProjectDirectory)/../panel" ContinueOnError="true" />
  </Target>

  <Target Name="StageManifest" AfterTargets="Build">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)/manifest.yml">
      <Output TaskParameter="Lines" ItemName="_ManifestLine" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(PluginOutputDir)/manifest.yml" Lines="@(_ManifestLine);version: $(RhinoAIPackageVersion)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/icon.png" DestinationFolder="$(PluginOutputDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BundleRouter" AfterTargets="Build">
    <ItemGroup>
      <_RouterRid Include="$([MSBuild]::Unescape($(RouterRids)))" />
    </ItemGroup>
    <Exec Command="dotnet publish Router.csproj -c $(Configuration) -r %(_RouterRid.Identity) -p:RhinoTarget=$(RhinoTarget) -o &quot;$(PluginOutputDir)/router/%(_RouterRid.Identity)&quot; --nologo" WorkingDirectory="$(MSBuildProjectDirectory)/../router" />
    <RemoveDir Directories="@(_RouterRid->'$(PluginOutputDir)/router/%(Identity)/rhino-mcp-router.dsym')" />
    <Delete Files="@(_RouterRid->'$(PluginOutputDir)/router/%(Identity)/rhino-mcp-router.pdb')" />
  </Target>

  <!-- Rhino does not load the ASP.NET Core shared framework, so the plug-in carries its own copy. -->
  <Target Name="BundleAspNetCore" AfterTargets="Build">
    <PropertyGroup>
      <_AspNetCoreDir>$(NuGetPackageRoot)microsoft.aspnetcore.app.runtime.$(AspNetCoreRuntimeRid)/$(AspNetCoreRuntimeVersion)/runtimes/$(AspNetCoreRuntimeRid)/lib/net8.0</_AspNetCoreDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(_AspNetCoreDir)')" Text="ASP.NET Core runtime pack not found at $(_AspNetCoreDir). Run dotnet restore." />
    <ItemGroup>
      <_AspNetCoreFile Include="$(_AspNetCoreDir)/*.dll"
                       Exclude="$(_AspNetCoreDir)/Microsoft.AspNetCore.Authentication.BearerToken.dll;
                                $(_AspNetCoreDir)/Microsoft.AspNetCore.Authentication.Cookies.dll;
                                $(_AspNetCoreDir)/Microsoft.AspNetCore.Authentication.OAuth.dll;
                                $(_AspNetCoreDir)/Microsoft.AspNetCore.Components*.dll;
                                $(_AspNetCoreDir)/Microsoft.AspNetCore.Identity*.dll;
                                $(_AspNetCoreDir)/Microsoft.AspNetCore.Mvc*.dll;
                                $(_AspNetCoreDir)/Microsoft.AspNetCore.Razor*.dll;
                                $(_AspNetCoreDir)/Microsoft.AspNetCore.Server.HttpSys.dll;
                                $(_AspNetCoreDir)/Microsoft.AspNetCore.Server.IIS*.dll;
                                $(_AspNetCoreDir)/Microsoft.AspNetCore.SignalR*.dll;
                                $(_AspNetCoreDir)/Microsoft.AspNetCore.StaticFiles.dll;
                                $(_AspNetCoreDir)/Microsoft.Extensions.Identity*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_AspNetCoreFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
