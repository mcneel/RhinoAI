<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(RhinoSrc4Dir)RhinoProjectPropertySheets/Rhino.CS.PlugIn.props" Condition="'$(IsInRhino)' == 'true'" />

  <PropertyGroup>
    <RhinoTarget Condition="'$(RhinoTarget)' == ''">R9</RhinoTarget>
    <PluginOS Condition="'$(PluginOS)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">win</PluginOS>
    <PluginOS Condition="'$(PluginOS)' == ''">osx</PluginOS>
    <RouterRids Condition="'$(RouterRids)' == '' AND '$(PluginOS)' == 'win'">win-x64;win-arm64</RouterRids>
    <RouterRids Condition="'$(RouterRids)' == ''">osx-arm64</RouterRids>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0;net48</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net8.0</TargetFrameworks>
    <AssemblyName>RhinoAI</AssemblyName>
    <RootNamespace>Rhino.AI</RootNamespace>
    <Title>Rhino AI</Title>
    <Description>AI tools for Rhino</Description>
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);$(RhinoTarget)</DefineConstants>
    <!-- CS0436: version.cs is also compiled into referenced Rhino assemblies whose internals are visible here. -->
    <NoWarn>$(NoWarn);NU1701;CA1416;MSB3277;CS0436</NoWarn>
    <PluginOutputDir Condition="'$(PluginOutputDir)' == '' AND '$(RhinoTarget)' == 'R9' AND '$(RhinoPlugInOutputDir)' != ''">$([MSBuild]::NormalizePath('$(RhinoPlugInOutputDir)', 'RhinoAI'))</PluginOutputDir>
    <PluginOutputDir Condition="'$(PluginOutputDir)' == ''">$(MSBuildProjectDirectory)/bin/$(RhinoTarget)-$(PluginOS)/$(Configuration)</PluginOutputDir>
    <OutputPath>$(PluginOutputDir)/</OutputPath>
    <!-- macOS: no target-framework subfolder, so the payload is flat in Plug-ins/RhinoAI
         (RhinoAI.rhp + dependencies + router/) exactly like Plug-ins/Grasshopper2. The Mac
         app-bundle install step in src4/BuildSolutions/MacDotNetMakefile copies that folder
         straight into ManagedPlugIns/RhinoAI.rhp, which is the layout the Mac plug-in loader
         expects (<Name>.rhp/<Name>.rhp). Windows keeps the net8.0 subfolder that
         installer/msi/Features/Plug-ins/RhinoAI.wxs harvests from. -->
    <AppendTargetFrameworkToOutputPath Condition="'$(PluginOS)' == 'osx'">false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../acp/Acp.csproj" />
    <Compile Include="../router/RouterPaths.ai.cs" Link="RouterPaths.ai.cs" />
    <Compile Include="../../../../../version.cs" Condition="'$(IsInRhino)' == 'true'">
      <Link>Properties\version.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- 8.19 is the first Rhino 8 package with .NET Core assets. -->
  <ItemGroup Condition="'$(RhinoTarget)' == 'R8'">
    <PackageReference Include="RhinoCommon" Version="8.19.25132.1001" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="8.19.25132.1001" ExcludeAssets="runtime" />
    <Compile Remove="Tools/GH2/**/*.cs;Resources/GH2/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RhinoTarget)' == 'R9'">
    <PackageReference Include="RhinoCommon" Version="9.0.26132.12305-wip" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="9.0.26132.12305-wip" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper2" Version="9.0.26132.12305-wip" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoCode" Version="9.0.26244.12303-beta" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../art/*.svg;../../art/*.ico" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\cs-cz\XML\cs-czRhinoAI.xml" Link="Localization\cs-czRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\de-de\XML\de-deRhinoAI.xml" Link="Localization\de-deRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\en-us\XML\en-usRhinoAI.xml" Link="Localization\en-usRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\es-es\XML\es-esRhinoAI.xml" Link="Localization\es-esRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\fr-fr\XML\fr-frRhinoAI.xml" Link="Localization\fr-frRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\it-it\XML\it-itRhinoAI.xml" Link="Localization\it-itRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\ja-jp\XML\ja-jpRhinoAI.xml" Link="Localization\ja-jpRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\ko-kr\XML\ko-krRhinoAI.xml" Link="Localization\ko-krRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\pl-pl\XML\pl-plRhinoAI.xml" Link="Localization\pl-plRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\pt-pt\XML\pt-ptRhinoAI.xml" Link="Localization\pt-ptRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\ru-ru\XML\ru-ruRhinoAI.xml" Link="Localization\ru-ruRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\tr-tr\XML\tr-trRhinoAI.xml" Link="Localization\tr-trRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\zh-cn\XML\zh-cnRhinoAI.xml" Link="Localization\zh-cnRhinoAI.xml" />
    <EmbeddedResource Include="..\..\..\..\..\..\Localization\Rhino\zh-tw\XML\zh-twRhinoAI.xml" Link="Localization\zh-twRhinoAI.xml" />
    <EmbeddedResource Include="Agents/Definitions.json" />
    <EmbeddedResource Include="Agents/codex-config.toml" LogicalName="Rhino.AI.codex-config.toml" />
    <EmbeddedResource Include="../panel/dist/panel.host.html" LogicalName="Rhino.AI.panel.html" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Localization\" />
  </ItemGroup>

  <Target Name="BuildPanel" BeforeTargets="BeforeBuild" Condition="'$(SkipPanelBuild)' != 'true' AND Exists('$(MSBuildProjectDirectory)/../panel/node_modules/esbuild')">
    <Exec Command="node build.mjs" WorkingDirectory="$(MSBuildProjectDirectory)/../panel" ContinueOnError="true" />
  </Target>

  <Target Name="StageManifest" AfterTargets="Build">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)/manifest.yml">
      <Output TaskParameter="Lines" ItemName="_ManifestLine" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(PluginOutputDir)/manifest.yml" Lines="@(_ManifestLine);version: $(RhinoAIPackageVersion)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/icon.png" DestinationFolder="$(PluginOutputDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BundleRouter" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net8.0'">
    <ItemGroup>
      <_RouterRid Include="$([MSBuild]::Unescape($(RouterRids)))" />
    </ItemGroup>
    <Exec Command="dotnet publish Router.csproj -c $(Configuration) -r %(_RouterRid.Identity) -p:RhinoTarget=$(RhinoTarget) -p:IsInRhino=$(IsInRhino) -p:UseSharedCompilation=false -o &quot;$(PluginOutputDir)/router/%(_RouterRid.Identity)&quot; --nologo" WorkingDirectory="$(MSBuildProjectDirectory)/../router" />
    <RemoveDir Directories="@(_RouterRid->'$(PluginOutputDir)/router/%(Identity)/rhino-mcp-router.dsym')" />
    <Delete Files="@(_RouterRid->'$(PluginOutputDir)/router/%(Identity)/rhino-mcp-router.pdb')" />
  </Target>

</Project>
